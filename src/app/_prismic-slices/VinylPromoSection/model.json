{
  "id": "vinyl_promo_section",
  "type": "SharedSlice",
  "name": "VinylPromoSection",
  "description": "Album promo — per-album graphics, product-driven availability, optional track previews",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "headline": {
          "type": "Text",
          "config": {
            "label": "Headline",
            "placeholder": ""
          }
        },
        "headline_sl": {
          "type": "Text",
          "config": {
            "label": "Headline (SL)",
            "placeholder": ""
          }
        },
        "description": {
          "type": "Text",
          "config": {
            "label": "Description",
            "placeholder": ""
          }
        },
        "description_sl": {
          "type": "Text",
          "config": {
            "label": "Description (SL)",
            "placeholder": ""
          }
        },
        "artist_name": {
          "type": "Text",
          "config": {
            "label": "Artist name",
            "placeholder": "e.g. MMali"
          }
        },
        "album_title": {
          "type": "Text",
          "config": {
            "label": "Album title",
            "placeholder": "e.g. Issun-bōshi"
          }
        },
        "cover_image": {
          "type": "Image",
          "config": {
            "label": "Cover image (square)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "record_image": {
          "type": "Image",
          "config": {
            "label": "Record image (spinning vinyl, optional)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "background_color": {
          "type": "Color",
          "config": {
            "label": "Background color"
          }
        },
        "product": {
          "type": "Link",
          "config": {
            "label": "Product",
            "select": "document",
            "repeat": false,
            "customtypes": [
              {
                "id": "product",
                "fields": [
                  "title"
                ]
              }
            ]
          }
        },
        "display_add_to_cart": {
          "type": "Boolean",
          "config": {
            "label": "Display add to cart",
            "placeholder_false": "false",
            "placeholder_true": "true",
            "default_value": false
          }
        },
        "digital_link": {
          "type": "Link",
          "config": {
            "label": "Buy digital link (e.g. Bandcamp, optional)",
            "placeholder": "https://…bandcamp.com/album/…",
            "select": null
          }
        },
        "soundcloud_playlist_url": {
          "type": "Text",
          "config": {
            "label": "SoundCloud playlist URL (optional — enables Play album)",
            "placeholder": "https://soundcloud.com/…/sets/…"
          }
        }
      },
      "items": {
        "track_title": {
          "type": "Text",
          "config": {
            "label": "Track title",
            "placeholder": ""
          }
        },
        "track_artist": {
          "type": "Text",
          "config": {
            "label": "Track artist",
            "placeholder": ""
          }
        },
        "track_url": {
          "type": "Text",
          "config": {
            "label": "SoundCloud track URL",
            "placeholder": "https://soundcloud.com/…"
          }
        }
      }
    }
  ]
}
